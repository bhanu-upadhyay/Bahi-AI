{
  "version": "1.0.0",
  "policy_name": "University Vendor Verification and Onboarding Rules",
  "last_updated": "2026-11-12",
  "gstin_regex": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$",
  "name_similarity_threshold": 0.80,
  "requirements": {
    "must_be_active": true,
    "must_have_verified_bank_details": true,
    "must_have_valid_gstin": true,
    "must_match_registered_vendor_code": true
  }
}

