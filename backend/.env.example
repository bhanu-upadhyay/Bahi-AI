APP_NAME=Bahi-AI
APP_ENV=development
DEBUG=true

# Database (PostgreSQL 16)
DATABASE_URL=postgresql+psycopg://bahi_user:local_dev_password@localhost:5434/bahi_ai

# Security & Authentication
JWT_SECRET_KEY=change-this-in-production-use-a-strong-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend & CORS
FRONTEND_URL=http://localhost:3000

# AI / Integrations
OPENAI_API_KEY=

# LLM & Gemini Orchestration (Google GenAI)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=your_gemini_api_key_here
LLM_TIMEOUT=30
LLM_MAX_TOKENS=2048
LLM_FALLBACK_ENABLED=true

