# ==============================================================================
# Bahi-AI — Environment Configuration Template
# ==============================================================================
# Copy this file to `backend/.env` and `frontend/.env.local` for local execution.
# NEVER commit real credentials, passwords, or JWT secrets to version control.
# ==============================================================================

# Application Settings
APP_NAME=Bahi-AI
APP_ENV=development
DEBUG=true

# Database (PostgreSQL 16 via Docker Compose)
# Default port 5434 maps to container port 5432
DATABASE_URL=postgresql+psycopg://bahi_user:local_dev_password@localhost:5434/bahi_ai
POSTGRES_USER=bahi_user
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=bahi_ai
POSTGRES_PORT=5434

# Security & Authentication
# Generate a secure secret in production (e.g., `openssl rand -hex 32`)
JWT_SECRET_KEY=dev-secret-key-bahi-ai-change-in-production-only-for-demo
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend & CORS
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# University ERP Simulation Mode
ERP_ADAPTER=mock
ERP_SIMULATE_LATENCY=true
ERP_SIMULATE_FAILURE=false

